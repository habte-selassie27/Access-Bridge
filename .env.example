GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=mstrl_REPLACE_WITH_YOUR_KEY
ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai
# Text to speech. Optional: demo audio is pre-recorded and the browser voice is
# the fallback. For keyless server TTS, run an OpenAI-compatible local endpoint
# (Kokoro-FastAPI, Piper, ...) and set TTS_PROVIDER=local with its base URL.
TTS_PROVIDER_KEY=
# TTS_PROVIDER=local
# TTS_BASE_URL=http://127.0.0.1:8880/v1
# TTS_MODEL=kokoro
# TTS_VOICE_ID=af_heart
#
# Gemini TTS is selected automatically when GEMINI_API_KEY is set, so the
# server can read Amharic, Tigrinya, Arabic and Swahili on a phone with no
# installed voice. Override the model or voice if needed:
# TTS_PROVIDER=gemini
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE_ID=Kore

# Server accounts. The default store is a JSON file; put it on persistent
# storage in production. COOKIE_SAMESITE=none is required when the frontend
# and the API are on different sites (the cookie is then Secure/HTTPS only).
# AUTH_STORE_PATH=./data/auth/users.json
# AUTH_SESSION_DAYS=30
# COOKIE_SAMESITE=lax
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_SPEND_CAP_USD=5
NEXT_PUBLIC_APP_URL=http://localhost:5173
DEMO_MODE_DEFAULT=false
PORT=3001

# Frontend (Vite). Set this to your production backend URL on Vercel:
VITE_API_BASE=https://pastewise-backend.onrender.com
