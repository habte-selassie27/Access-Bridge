{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    // Do not force "vite/client" here. The frontend install does not ship a
    // standalone resolvable "vite/client" TS type package in this build setup,
    // so requiring it in `types` produces TS2688 during `tsc --noEmit`.
    // Vite's own types are provided through `src/vite-env.d.ts` and the vite
    // package itself.
    "types": [],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
